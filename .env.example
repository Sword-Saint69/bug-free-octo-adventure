# =====================================================================
# ESP32-S3 Microcontroller Project API - Environment Template (.env.example)
# Production / deployment cheyyumbo ee file copy cheyth .env aakki use cheyyam.
# =====================================================================

PROJECT_NAME="Microcontroller Dashboard API"
API_V1_STR="/api/v1"
SECRET_KEY="your_production_secret_key_here"

# Default Coordinates
DEFAULT_LATITUDE=20.2961
DEFAULT_LONGITUDE=85.8245
DEFAULT_COUNTRY_CODE="IN"

# Optional Cloud API Keys
OPENAQ_API_KEY=""
COINGECKO_API_KEY=""
NASA_API_KEY="DEMO_KEY"

# Comma-separated browser origins. Include local development and the hosted
# frontend URL. Do not add /docs or /api/v1 to an origin.
CORS_ORIGINS="http://localhost:5173,https://your-frontend-domain.example"

# Docker Compose overrides this to a persistent named volume.
RUNTIME_CONFIG_PATH=""
